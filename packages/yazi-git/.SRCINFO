pkgbase = yazi-git
	gives = yazi
	pkgver = 0.r0
	pkgdesc = Blazing fast terminal file manager written in Rust
	url = https://yazi-rs.github.io
	arch = amd64
	arch = arm64
	makedepends = file
	makedepends = git
	makedepends = ffmpeg
	makedepends = p7zip-full
	makedepends = jq
	makedepends = poppler-utils
	makedepends = fd-find
	makedepends = ripgrep
	makedepends = fzf
	makedepends = zoxide
	makedepends = imagemagick
	makedepends = wl-clipboard
	makedepends = xclip
	makedepends = build-essential
	makedepends = libgcc-12-dev
	makedepends = glibc-source
	makedepends = cargo-1.95 | cargo>=1.95 | rustup
	source = git+https://github.com/sxyazi/yazi.git

pkgname = yazi-git
