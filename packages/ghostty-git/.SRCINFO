pkgbase = ghostty-git
	gives = ghostty
	pkgver = 0.r0
	pkgdesc = Ghostty is a fast, feature-rich, and cross-platform terminal emulator that uses platform-native UI and GPU acceleration
	url = https://ghostty.org/
	arch = amd64
	arch = arm64
	makedepends = libgtk-4-dev
	makedepends = libadwaita-1-dev
	makedepends = gettext
	makedepends = libxml2-utils
	makedepends = pkg-config | pkgconf
	pacdeps = zig-bin
	pacdeps = blueprint-compiler
	maintainer = CiccioBro17 <203853964+CiccioBro17@users.noreply.github.com>
	source = git+https://github.com/ghostty-org/ghostty.git

pkgname = ghostty-git
